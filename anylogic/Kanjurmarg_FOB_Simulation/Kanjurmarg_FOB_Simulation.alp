			<Events>
				<Event>
					<Id>1761600000048</Id>
					<Name><![CDATA[minuteTick]]></Name>
					<X>-500</X><Y>40</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[60]]></Code><Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_SECOND]]></Unit>
						</Rate>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1761535860000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[60]]></Code><Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[60]]></Code><Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[// Close the one-minute interval that has just ended and update the utilization dashboard.
int m = (int) Math.round(time() / 60.0) - 1;
if (m < 0 || m >= durationMin) return;
lastU2 = fob2PerMin[m] / capacity2() * 100.0;
lastU3 = fob3PerMin[m] / capacity3() * 100.0;
peakU2 = Math.max(peakU2, lastU2);
peakU3 = Math.max(peakU3, lastU3);
sumU2 += lastU2;
sumU3 += lastU3;
minutesDone = m + 1;

// live gauges (full bar = 50% of reference capacity) and heat-coloured bridge decks
double full = 300;
barU2.setWidth(Math.max(1, Math.min(full, full * lastU2 / 50.0)));
barU3.setWidth(Math.max(1, Math.min(full, full * lastU3 / 50.0)));
fob2Deck.setFillColor(heatColor(lastU2));
fob3Deck.setFillColor(heatColor(lastU3));

if (minutesDone >= durationMin) {
	runFinished = true;
	traceln("Run complete: FOB 2 mean %.1f%% (peak %.1f%%), FOB 3 mean %.1f%% (peak %.1f%%)",
		sumU2 / minutesDone, peakU2, sumU3 / minutesDone, peakU3);
	getEngine().pause();
}]]></Action>
				</Event>
			</Events>
			<DynamicEvents>
				<DynamicEventClass>
					<Id>1761600000049</Id>
					<Name><![CDATA[Arrival]]></Name>
					<X>-500</X><Y>90</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter><Name><![CDATA[stream]]></Name><Type><![CDATA[int]]></Type></Parameter>
					<Action><![CDATA[// Poisson arrival for stream 'stream': choose the route with this gate's split, then schedule the next arrival.
if (time() >= durationMin * 60.0) return;            // arrivals stop at the end of the run
int gate = FobEngine.gateOf(stream);
int route = FobEngine.drawRoute(streamRng[stream], FobEngine.splitForStream(stream, splitsUsed, extraSplitsUsed));
spawnPassenger(stream, route);
double lambda = FobEngine.ratePerMin(stream, additionalDemand);
create_Arrival(FobEngine.drawInterarrivalSec(streamRng[stream], lambda), stream);]]></Action>
				</DynamicEventClass>
				<DynamicEventClass>
					<Id>1761600000050</Id>
					<Name><![CDATA[Waypoint]]></Name>
					<X>-500</X><Y>120</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter><Name><![CDATA[p]]></Name><Type><![CDATA[Passenger]]></Type></Parameter>
					<Action><![CDATA[p.wpIndex++;
p.jumpTo(toPxX(p.wpPath[p.wpIndex][0]), toPxY(p.wpPath[p.wpIndex][1]));
advance(p);]]></Action>
				</DynamicEventClass>
				<DynamicEventClass>
					<Id>1761600000051</Id>
					<Name><![CDATA[Crossing]]></Name>
					<X>-500</X><Y>150</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter><Name><![CDATA[fob]]></Name><Type><![CDATA[int]]></Type></Parameter>
					<Action><![CDATA[// Count one FOB crossing in the one-minute interval in which it happens.
int minute = (int) Math.floor(time() / 60.0);
if (minute >= durationMin) return;
if (fob == 2) fob2PerMin[minute]++;
else if (fob == 3) fob3PerMin[minute]++;]]></Action>
				</DynamicEventClass>
			</DynamicEvents>
			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1761600000052</Id>
					<Name><![CDATA[spawnPassenger]]></Name>
					<X>-500</X><Y>230</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter><Name><![CDATA[stream]]></Name><Type><![CDATA[int]]></Type></Parameter><Parameter><Name><![CDATA[route]]></Name><Type><![CDATA[int]]></Type></Parameter>
					<Body><![CDATA[// Create one passenger of the given stream on the chosen route and start walking.
int gate = FobEngine.gateOf(stream);
boolean entering = FobEngine.isEntering(stream);
Passenger p = add_passengers();
p.routeIdx = route;
p.entering = entering;
p.wpPath = FobEngine.waypoints(gate, entering, route);
p.wpIndex = 0;
p.jumpTo(toPxX(p.wpPath[0][0]), toPxY(p.wpPath[0][1]));
p.setSpeed(walkSpeed, MPS);
int fob = FobEngine.fobOf(route);
if (fob != 0) {
	// counted once, when the passenger reaches the FOB deck mid-point (skywalk users count on FOB 3)
	create_Crossing(FobEngine.crossingDelaySec(gate, entering, route, walkSpeed), fob);
}
advance(p);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1761600000053</Id>
					<Name><![CDATA[advance]]></Name>
					<X>-500</X><Y>260</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter><Name><![CDATA[p]]></Name><Type><![CDATA[Passenger]]></Type></Parameter>
					<Body><![CDATA[// Send the passenger to its next way-point, or remove it when the path is finished.
if (p.wpIndex >= p.wpPath.length - 1) {
	remove_passengers(p);
	return;
}
double[] a = p.wpPath[p.wpIndex];
double[] b = p.wpPath[p.wpIndex + 1];
p.moveTo(toPxX(b[0]), toPxY(b[1]));
create_Waypoint(FobEngine.segmentLength(a, b) / walkSpeed, p);]]></Body>
				</Function>
