			<Events>
				<Event>
					<Id>1761530000056</Id>
					<Name><![CDATA[minuteTick]]></Name>
					<X>-500</X><Y>40</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[60]]></Code><Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_SECOND]]></Unit>
						</Rate>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1761535860000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[60]]></Code><Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[60]]></Code><Unit Class="TimeUnits"><![CDATA[SECOND]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[// Close the one-minute interval that has just ended and update the dashboard.
int m = (int) Math.round(time() / 60.0) - 1;
if (m < 0 || m >= durationMin) return;
lastFlow2 = fob2PerMin[m];
lastFlow3 = fob3PerMin[m];
lastU2 = lastFlow2 / capacity2() * 100.0;
lastU3 = lastFlow3 / capacity3() * 100.0;
peakU2 = Math.max(peakU2, lastU2);
peakU3 = Math.max(peakU3, lastU3);
sumU2 += lastU2;
sumU3 += lastU3;
minutesDone = m + 1;
utilHist2.add(lastU2);
utilHist3.add(lastU3);

// live utilization bars (full bar = 50% of reference capacity)
double full = 250;
barU2.setWidth(Math.min(full, full * lastU2 / 50.0));
barU3.setWidth(Math.min(full, full * lastU3 / 50.0));
barU2.setFillColor(utilColor(lastU2));
barU3.setFillColor(utilColor(lastU3));

if (minutesDone >= durationMin) {
	runFinished = true;
	traceln("Run complete: FOB2 %d crossings (%.2f pax/min), FOB3 %d crossings (%.2f pax/min), FOB1 %d",
		fob2Total, fob2Total / (double) durationMin, fob3Total, fob3Total / (double) durationMin, fob1Total);
	getEngine().pause();
}]]></Action>
				</Event>
			</Events>
			<DynamicEvents>
				<DynamicEventClass>
					<Id>1761530000057</Id>
					<Name><![CDATA[Arrival]]></Name>
					<X>-500</X><Y>90</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter><Name><![CDATA[stream]]></Name><Type><![CDATA[int]]></Type></Parameter>
					<Action><![CDATA[// Poisson arrival for stream 'stream': create the passenger, then schedule the next arrival.
if (time() >= durationMin * 60.0) return;            // arrivals stop at the end of the run
int route = FobEngine.drawRoute(streamRng[stream], routeProbs());
spawnPassenger(stream, route);
double lambda = FobEngine.baseRatePerMin(stream) * demandMultiplier;
create_Arrival(FobEngine.drawInterarrivalSec(streamRng[stream], lambda), stream);]]></Action>
				</DynamicEventClass>
				<DynamicEventClass>
					<Id>1761530000058</Id>
					<Name><![CDATA[Waypoint]]></Name>
					<X>-500</X><Y>120</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter><Name><![CDATA[p]]></Name><Type><![CDATA[Passenger]]></Type></Parameter>
					<Action><![CDATA[p.wpIndex++;
p.jumpTo(toPxX(p.wpPath[p.wpIndex][0]), toPxY(p.wpPath[p.wpIndex][1]));
advance(p);]]></Action>
				</DynamicEventClass>
				<DynamicEventClass>
					<Id>1761530000059</Id>
					<Name><![CDATA[Crossing]]></Name>
					<X>-500</X><Y>150</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter><Name><![CDATA[route]]></Name><Type><![CDATA[int]]></Type></Parameter>
					<Action><![CDATA[// Count one FOB crossing in the one-minute interval in which it happens.
int minute = (int) Math.floor(time() / 60.0);
if (minute >= durationMin) return;
if (route == FobEngine.ROUTE_FOB2) { fob2PerMin[minute]++; fob2Total++; }
else if (route == FobEngine.ROUTE_FOB3) { fob3PerMin[minute]++; fob3Total++; }
else { fob1Total++; }   // unreachable: FOB 1 is closed (kept as an explicit check)]]></Action>
				</DynamicEventClass>
			</DynamicEvents>
			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double[]]]></ReturnType>
					<Id>1761530000060</Id>
					<Name><![CDATA[routeProbs]]></Name>
					<X>-500</X><Y>200</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					
					<Body><![CDATA[// Configured route probabilities (Direct PF1, FOB 2, FOB 3). FOB 1 is closed and has no entry.
double[] p = {pDirectPF1, pFOB2, pFOB3};
double sum = p[0] + p[1] + p[2];
if (Math.abs(sum - 1.0) > 1e-9) {          // normalise if the user typed shares that do not add to 1
	for (int i = 0; i < 3; i++) p[i] = p[i] / sum;
}
return p;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1761530000061</Id>
					<Name><![CDATA[spawnPassenger]]></Name>
					<X>-500</X><Y>230</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter><Name><![CDATA[stream]]></Name><Type><![CDATA[int]]></Type></Parameter><Parameter><Name><![CDATA[route]]></Name><Type><![CDATA[int]]></Type></Parameter>
					<Body><![CDATA[// Create one passenger of the given stream on the chosen route and start walking.
int entrance = FobEngine.entranceOf(stream);
boolean entering = FobEngine.isEntering(stream);
Passenger p = add_passengers();
p.routeIdx = route;
p.entering = entering;
p.entrance = entrance;
p.wpPath = FobEngine.waypoints(entrance, entering, route);
p.wpIndex = 0;
p.jumpTo(toPxX(p.wpPath[0][0]), toPxY(p.wpPath[0][1]));
p.setSpeed(walkSpeed, MPS);

generated++;
routeCount[route]++;
if (route != FobEngine.ROUTE_PF1) {
	// the crossing is counted once, when the passenger reaches the FOB deck mid-point
	create_Crossing(FobEngine.crossingDelaySec(entrance, entering, route, walkSpeed), route);
}
advance(p);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1761530000062</Id>
					<Name><![CDATA[advance]]></Name>
					<X>-500</X><Y>260</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter><Name><![CDATA[p]]></Name><Type><![CDATA[Passenger]]></Type></Parameter>
					<Body><![CDATA[// Send the passenger to its next way-point, or remove it when the path is finished.
if (p.wpIndex >= p.wpPath.length - 1) {
	completed++;
	remove_passengers(p);
	return;
}
double[] a = p.wpPath[p.wpIndex];
double[] b = p.wpPath[p.wpIndex + 1];
p.moveTo(toPxX(b[0]), toPxY(b[1]));
create_Waypoint(FobEngine.segmentLength(a, b) / walkSpeed, p);]]></Body>
				</Function>
